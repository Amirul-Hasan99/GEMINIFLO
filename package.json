{
  "name": "geminiflo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "db:bootstrap": "node --env-file=.env.local scripts/bootstrap.mjs",
    "e2e:production": "node scripts/e2e-check.mjs",
    "test:firebase": "node --experimental-strip-types --test test/firebase_token.test.mjs",
    "web:run": "node scripts/flutter_web.mjs run",
    "web:build": "node scripts/flutter_web.mjs build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {
    "@vercel/node": "^5.3.0",
    "typescript": "^5.9.3"
  }
}
